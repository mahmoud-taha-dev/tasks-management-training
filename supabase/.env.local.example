# Local SMTP settings for send-invite-email.
# Copy this file to supabase/.env.local and fill in your provider credentials.
# Supabase CLI injects SUPABASE_URL and Supabase API keys automatically.
# Do not commit supabase/.env.local.

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
